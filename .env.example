# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=
# --- Server ---------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///./data/app.db

# --- Browser --------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true

# --- Claude ---------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_IMAGE_MAX_SIDE=1024

# --- Behaviour ------------------------------------------------------------
AUTO_PUBLISH=false
MATCH_THRESHOLD=85
STRIP_SOURCE_FROM_DESCRIPTION=true
ALLOW_PRIVATE_SOURCE_URLS=false

# --- Image limits ---------------------------------------------------------
MIN_IMAGE_SIDE=500
MIN_FINAL_SIDE=400
MAX_DOWNLOAD_BYTES=15000000
MAX_UPLOAD_BYTES=2500000
MAX_CANDIDATES=30
MAX_ANALYZE=24
MAX_OUTPUT_SIDE=2000
OUTPUT_FORMAT=jpeg
JPEG_QUALITY=88

# --- Frontend origins allowed by CORS (comma separated) -------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
